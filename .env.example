# ─────────────────────────────────────────────────────────────
# Vennzya Fashion Hub — environment
# Copy to `.env` and fill in. Only vars prefixed NEXT_PUBLIC_ ever
# reach the browser bundle. Never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────

# --- Core (required) ---------------------------------------------------------
DATABASE_URL="postgresql://vennzya:vennzya_dev@localhost:5432/vennzya?schema=public"
# Neon only: unpooled connection used by `prisma migrate`. Local dev can mirror DATABASE_URL.
DIRECT_URL="postgresql://vennzya:vennzya_dev@localhost:5432/vennzya?schema=public"

# 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects the on-demand ISR revalidation endpoint.
REVALIDATE_SECRET="replace-me-with-a-random-string"

# --- Business config (required) ----------------------------------------------
# Seller's GST-registered state — decides CGST+SGST (intra-state) vs IGST (inter-state).
SELLER_STATE="Tamil Nadu"
SELLER_GSTIN=""
NEXT_PUBLIC_WHATSAPP_NUMBER="919000000000"

# --- Payments: Razorpay (optional in dev; required to accept real payments) ---
# Test keys from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Email: Resend (optional in dev → falls back to Mailpit/console) ---------
RESEND_API_KEY=""
EMAIL_FROM="Vennzya Fashion Hub <orders@example.com>"

# --- SMS/OTP (optional in dev → OTP is printed to the server console) --------
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""

# --- Images: Cloudinary (optional in dev → local /public/uploads fallback) ---
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Cache / rate limiting: Upstash (optional in dev → in-memory limiter) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Background jobs: Inngest (optional in dev → local dev server) -----------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Observability: Sentry (optional) ---------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA_ID=""

# --- Seed data ---------------------------------------------------------------
OWNER_EMAIL="owner@vennzya.test"
OWNER_PASSWORD="ChangeMe!2026"
