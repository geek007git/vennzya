// Vennzya Fashion Hub — data model
// Conventions:
//  - Money is Decimal(10,2). Never Float.
//  - Orders snapshot product data at purchase time, so later catalogue edits
//    never rewrite history.
//  - Every stock change is journalled in StockMovement.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity (Better Auth owns these tables)
// One identity table for everyone; `role` separates shoppers from staff.
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?

  phoneNumber         String?  @unique
  phoneNumberVerified Boolean? @default(false)

  role       UserRole  @default(CUSTOMER)
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  addresses       Address[]
  orders          Order[]
  cart            Cart?
  permissions     StaffPermission[]
  invitesSent     StaffInvite[]     @relation("InviteAuthor")
  auditLogs       AdminAuditLog[]
  stockMovements  StockMovement[]
  couponsCreated  Coupon[]
  contentEdits    ContentPage[]
  contactHandled  ContactSubmission[]
  couponRedemptions CouponRedemption[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id        String @id @default(cuid())
  accountId String
  /// Better Auth namespaces credentials by issuer: "local:credential" for
  /// email+password, the provider's issuer URL for OAuth. Account lookups go
  /// through (issuer, accountId), so this must exist and be unique with it.
  issuer     String
  providerId String
  userId     String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// ─────────────────────────────────────────────────────────────
// Staff access control
// ─────────────────────────────────────────────────────────────

model Permission {
  key         String @id
  description String

  staff StaffPermission[]
}

model StaffPermission {
  userId        String
  permissionKey String
  grantedAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([userId, permissionKey])
  @@index([userId])
}

model StaffInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        UserRole  @default(STAFF)
  permissions String[]
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  imageUrl       String?
  parentId       String?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
  coupons  CouponCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  shortDescription String?
  status      ProductStatus @default(DRAFT)

  // GST: HSN code + rate drive the CGST/SGST/IGST split at checkout.
  hsnCode        String
  gstRatePercent Decimal @default(5) @db.Decimal(5, 2)

  brand          String?
  careInstructions String?
  seoTitle       String?
  seoDescription String?
  isFeatured     Boolean @default(false)
  publishedAt    DateTime?

  // Denormalised from variants so the catalogue can filter and sort on price
  // and availability with a plain index instead of a per-row aggregate.
  // Maintained by CatalogService.syncProductAggregates().
  minPrice   Decimal? @db.Decimal(10, 2)
  maxPrice   Decimal? @db.Decimal(10, 2)
  totalStock Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories  ProductCategory[]
  options     ProductOption[]
  variants    ProductVariant[]
  images      ProductImage[]
  collections CollectionProduct[]
  coupons     CouponProduct[]

  @@index([status, publishedAt])
  @@index([status, minPrice])
  @@index([status, totalStock])
  @@index([isFeatured])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

/// An attribute axis: "Size", "Colour", "Metal", "Stone".
/// Adding a new axis for a new product type needs data, not a migration.
model Option {
  id        String  @id @default(cuid())
  name      String  @unique
  /// Renders as swatches instead of pills when true (e.g. Colour).
  isSwatch  Boolean @default(false)
  sortOrder Int     @default(0)

  values   OptionValue[]
  products ProductOption[]
}

model OptionValue {
  id        String  @id @default(cuid())
  optionId  String
  value     String
  /// Hex colour for swatch rendering.
  swatchHex String?
  sortOrder Int     @default(0)

  option   Option               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, sortOrder])
}

model ProductOption {
  productId String
  optionId  String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  Option  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  sku             String  @unique
  price           Decimal @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  stockQuantity   Int     @default(0)
  lowStockThreshold Int   @default(5)
  weightGrams     Int?
  barcode         String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([stockQuantity])
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  url       String
  /// Cloudinary public id, so the asset can be deleted/transformed later.
  publicId  String?
  altText   String?
  width     Int?
  height    Int?
  blurDataUrl String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCELLATION
}

/// Append-only journal. Current stock is ProductVariant.stockQuantity;
/// this explains how it got there.
model StockMovement {
  id             String            @id @default(cuid())
  variantId      String
  type           StockMovementType
  quantityDelta  Int
  resultingStock Int
  orderId        String?
  createdById    String?
  note           String?
  createdAt      DateTime          @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Customers & addresses
// ─────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AddressKind {
  SHIPPING
  BILLING
}

/// Frozen copy of the address as it was when the order was placed.
model OrderAddress {
  id         String      @id @default(cuid())
  orderId    String
  kind       AddressKind
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String      @default("IN")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
}

// ─────────────────────────────────────────────────────────────
// Cart (server-side, for signed-in shoppers; guests keep it client-side)
// ─────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─────────────────────────────────────────────────────────────
// Orders, payments, tax
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  CREATED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum ShippingStatus {
  NOT_SHIPPED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_INITIATED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  userId      String

  status         OrderStatus    @default(CREATED)
  paymentStatus  PaymentStatus  @default(PENDING)
  shippingStatus ShippingStatus @default(NOT_SHIPPED)
  paymentMethod  PaymentMethod

  // Money. taxableAmount = subtotal - discountAmount; tax is computed on that.
  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  shippingFee    Decimal @default(0) @db.Decimal(10, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(10, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(10, 2)
  igstAmount     Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)
  currency       String  @default("INR")

  couponId            String?
  couponCodeSnapshot  String?

  contactEmail String?
  contactPhone String
  customerNote String?
  adminNote    String?

  /// Lets a guest open their confirmation page without an account.
  guestAccessToken String? @unique

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id])
  items          OrderItem[]
  addresses      OrderAddress[]
  payments       Payment[]
  tracking       ShipmentTracking[]
  stockMovements StockMovement[]
  coupon         Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption     CouponRedemption?

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([shippingStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?

  // Snapshots — the order stays truthful even if the product is edited or deleted.
  productNameSnapshot      String
  productSlugSnapshot      String
  skuSnapshot              String
  imageUrlSnapshot         String?
  variantAttributesSnapshot Json
  hsnCodeSnapshot          String
  gstRateSnapshot          Decimal @db.Decimal(5, 2)

  unitPrice     Decimal @db.Decimal(10, 2)
  quantity      Int
  lineSubtotal  Decimal @db.Decimal(10, 2)
  lineDiscount  Decimal @default(0) @db.Decimal(10, 2)
  lineTaxAmount Decimal @default(0) @db.Decimal(10, 2)
  lineTotal     Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum PaymentRecordStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_AWAITING
  COD_COLLECTED
}

model Payment {
  id       String @id @default(cuid())
  orderId  String
  provider String @default("RAZORPAY")

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amount         Decimal             @db.Decimal(10, 2)
  refundedAmount Decimal             @default(0) @db.Decimal(10, 2)
  currency       String              @default("INR")
  status         PaymentRecordStatus @default(CREATED)
  method         String?
  failureReason  String?
  rawPayload     Json?
  verifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

/// Idempotency ledger: a redelivered webhook can never be processed twice.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  eventType       String
  providerEventId String    @unique
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  error           String?

  @@index([provider, eventType])
}

model ShipmentTracking {
  id                 String    @id @default(cuid())
  orderId            String
  courierName        String
  trackingNumber     String
  trackingUrl        String?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  estimatedDeliveryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Discounts
// ─────────────────────────────────────────────────────────────

enum CouponType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)

  minOrderValue     Decimal? @db.Decimal(10, 2)
  /// Caps a percentage coupon, e.g. "20% off, max ₹500".
  maxDiscountAmount Decimal? @db.Decimal(10, 2)

  startsAt  DateTime?
  expiresAt DateTime?

  usageLimitTotal       Int?
  usageLimitPerCustomer Int?
  usedCount             Int  @default(0)

  isActive    Boolean @default(true)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  products    CouponProduct[]
  categories  CouponCategory[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive, expiresAt])
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  orderId        String   @unique
  userId         String
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ─────────────────────────────────────────────────────────────
// Owner-managed content
// ─────────────────────────────────────────────────────────────

enum BannerPlacement {
  ANNOUNCEMENT_BAR
  HOMEPAGE_HERO
  HOMEPAGE_SECONDARY
  CATEGORY_TOP
}

model PromoBanner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  ctaLabel  String?
  placement BannerPlacement
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, sortOrder])
}

/// Curated merchandising groups ("Festive Edit"), independent of the category tree.
model Collection {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Testimonial {
  id         String  @id @default(cuid())
  authorName String
  location   String?
  body       String
  rating     Int?
  imageUrl   String?
  isApproved Boolean @default(false)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApproved, isFeatured])
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Policy/legal copy the owner edits without a deploy.
model ContentPage {
  pageKey      String  @id
  title        String
  bodyMarkdown String
  seoTitle     String?
  seoDescription String?
  updatedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactSubmission {
  id      String        @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String
  status  ContactStatus @default(NEW)

  respondedById String?
  respondedAt   DateTime?

  createdAt DateTime @default(now())

  respondedBy User? @relation(fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
